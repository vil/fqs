set -euo pipefail

# Keep sourcing side-effect free so helpers can be tested without changing a host.
command_exists() { command -v "$1" &>/dev/null; }
CONFIG_POLICY=keep
CONFIG_CHANGED=false
CONFIG_READY=false
CURRENT_ACTION="startup"
WORK_DIR=""
SUDO_PID=""
BACKUP_DIR=""

cleanup() {
    if [[ -n "$SUDO_PID" ]]; then
        kill "$SUDO_PID" 2>/dev/null || true
        wait "$SUDO_PID" 2>/dev/null || true
    fi
    if [[ -n "$WORK_DIR" ]]; then rm -rf -- "$WORK_DIR"; fi
}

fail() { printf 'Error: %s\n' "$*" >&2; return 1; }

on_error() {
    local status="$1" line="$2"
    trap - ERR
    printf '\nFQS stopped during: %s (line %s, status %s).\n' "$CURRENT_ACTION" "$line" "$status" >&2
    printf 'Earlier changes are NOT rolled back. Review the output before retrying.\n' >&2
    if [[ -n "$BACKUP_DIR" ]]; then printf 'Configuration backups: %s\n' "$BACKUP_DIR" >&2; fi
    exit "$status"
}

# Stage complete contents before touching a destination. Keep existing files by
# default; replacement is an explicit wizard-wide choice with per-file backups.
write_config() {
    local target="$1" mode="${2:-0644}" staged
    CONFIG_CHANGED=false
    CONFIG_READY=false
    staged=$(mktemp "$WORK_DIR/config.XXXXXX")
    cat > "$staged"
    if sudo test -L "$target"; then
        fail "Refusing to replace symlink: $target"
        return 1
    fi
    if sudo test -e "$target"; then
        if ! sudo test -f "$target"; then fail "Not a regular file: $target"; return 1; fi
        if sudo cmp -s "$staged" "$target"; then
            printf 'Already configured: %s\n' "$target"
            CONFIG_READY=true
            return 0
        fi
        if [[ "$CONFIG_POLICY" == keep ]]; then
            printf 'Keeping existing configuration (new settings not applied): %s\n' "$target"
            return 0
        fi
        if [[ -z "$BACKUP_DIR" ]]; then
            BACKUP_DIR="/var/backups/fqs/$(date +%Y%m%d-%H%M%S)-$$"
            sudo install -d -m 0700 "$BACKUP_DIR"
        fi
        sudo cp --parents --preserve=all -- "$target" "$BACKUP_DIR/"
    fi
    if ! sudo test -d "$(dirname "$target")"; then
        sudo install -d -m 0755 "$(dirname "$target")"
    fi
    # Rename in the same directory so interrupted writes cannot truncate config.
    local adjacent
    adjacent=$(sudo mktemp "${target}.fqs.XXXXXX")
    sudo install -m "$mode" "$staged" "$adjacent"
    sudo mv -fT -- "$adjacent" "$target"
    if command_exists restorecon; then sudo restorecon "$target"; fi
    CONFIG_CHANGED=true
    CONFIG_READY=true
}

unit_exists() {
    local state
    state=$(systemctl show -p LoadState --value "$1") || return 1
    [[ -n "$state" && "$state" != not-found ]]
}

disable_units() {
    local unit
    for unit in "$@"; do
        if unit_exists "$unit"; then
            sudo systemctl disable --now "$unit"
            sudo systemctl mask "$unit"
        else
            printf 'Unit not installed; skipping: %s\n' "$unit"
        fi
    done
}

ensure_flatpak() {
    if ! command_exists flatpak; then sudo dnf install -y flatpak; fi
    sudo flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
}

add_repo() {
    local url="$1" target="$2" downloaded
    if sudo test -e "$target"; then printf 'Repository already exists: %s\n' "$target"; return 0; fi
    downloaded=$(mktemp "$WORK_DIR/repo.XXXXXX")
    curl --fail --show-error --location --proto '=https' --proto-redir '=https' "$url" -o "$downloaded"
    grep -q '^\[' "$downloaded" || { fail "Invalid repository file from $url"; return 1; }
    write_config "$target" < "$downloaded"
}

# Core

sys_update() {
    echo -e "\n=> Performing system upgrade..."
    sudo dnf upgrade --refresh -y
}

setup_repos() {
    echo -e "\n=> Adding RPM Fusion, Terra, and Flathub..."
    local fedora_ver
    fedora_ver="$(rpm -E %fedora)"
    [[ "$fedora_ver" =~ ^[0-9]+$ ]] || { fail 'Cannot determine a numeric Fedora release.'; return 1; }
    sudo dnf install -y "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-${fedora_ver}.noarch.rpm" \
                        "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${fedora_ver}.noarch.rpm"
    # Trust Terra's HTTPS-published key explicitly during bootstrap, without
    # disabling package or repository metadata signature verification.
    if ! rpm -q terra-release &>/dev/null; then
        sudo dnf install --repofrompath "terra,https://repos.fyralabs.com/terra${fedora_ver}" \
            --setopt="terra.gpgkey=https://repos.fyralabs.com/terra${fedora_ver}/key.asc" \
            --setopt=terra.gpgcheck=1 --setopt=terra.repo_gpgcheck=1 terra-release -y
    fi
    sudo dnf install -y dnf-plugins-core
    sudo dnf group upgrade core -y
    sudo dnf install -y terra-release-extras terra-release-mesa

    if ! command_exists flatpak; then
        sudo dnf install flatpak -y
    fi
    ensure_flatpak
}

append_dnf_configs() {
    echo -e "\n=> Optimizing DNF..."
    local conf_file="/etc/dnf/dnf.conf"
    local staged
    staged=$(mktemp "$WORK_DIR/dnf.XXXXXX")
    if sudo test -f "$conf_file"; then sudo cat "$conf_file" > "$staged"; fi
    # Only fill missing keys in [main]; preserve administrator values and sections.
    python3 - "$staged" <<'PY'
import configparser
import sys
path = sys.argv[1]
config = configparser.ConfigParser(interpolation=None, strict=False)
with open(path) as stream:
    text = stream.read()
config.read_string(text)
settings = {'gpgcheck': '1', 'max_parallel_downloads': '10',
            'installonly_limit': '3', 'clean_requirements_on_remove': 'True'}
missing = {key: value for key, value in settings.items()
           if not config.has_option('main', key)}
lines = text.splitlines(keepends=True)
addition = ''.join(f'{key}={value}\n' for key, value in missing.items())
for index, line in enumerate(lines):
    if line.strip() == '[main]':
        lines.insert(index + 1, '\n' + addition)
        break
else:
    lines.append('\n[main]\n' + addition)
with open(path, 'w') as stream:
    stream.write(''.join(lines))
PY
    write_config "$conf_file" < "$staged"
}

setup_auto_updates() {
    echo -e "\n=> Setting up DNF Automatic Updates..."
    local package=dnf-automatic timer=dnf-automatic.timer
    local version
    version=$(dnf --version)
    if [[ "$version" == *dnf5* ]]; then
        package=dnf5-plugin-automatic
        timer=dnf5-automatic.timer
    fi
    sudo dnf install -y "$package"
    local conf_file="/etc/dnf/automatic.conf"

    write_config "$conf_file" <<'EOF'
[commands]
upgrade_type = security
random_sleep = 0
download_updates = yes
apply_updates = yes

[emitters]
emit_via = stdio
EOF
    # An existing configuration may intentionally disable application of updates.
    if ! sudo python3 - "$conf_file" <<'PY'
import configparser
import sys
config = configparser.ConfigParser(interpolation=None)
try:
    with open(sys.argv[1]) as stream:
        config.read_file(stream)
    valid = (config.get('commands', 'upgrade_type', fallback='default') == 'security'
             and config.getboolean('commands', 'apply_updates', fallback=False)
             and config.get('commands', 'reboot', fallback='never') == 'never')
except (OSError, ValueError, configparser.Error):
    valid = False
sys.exit(0 if valid else 1)
PY
    then
        printf 'Automatic updates not enabled: config must specify security-only updates, apply_updates=yes and no automatic reboot.\n'
        return 0
    fi
    unit_exists "$timer" || { fail "Automatic update timer is unavailable: $timer"; return 1; }
    sudo systemctl enable --now "$timer"
}

