disable_obscure_fs() {
    echo -e "\n=> Disabling obscure filesystems..."
    local conf_file_fs="/etc/modprobe.d/disable-fs.conf" fs
    for fs in cramfs freevxfs jffs2 hfs hfsplus; do
        if findmnt -rn -t "$fs" | grep -q . ||
           awk -v fs="$fs" '$1 !~ /^#/ && $3 == fs {found=1} END {exit !found}' /etc/fstab; then
            fail "Filesystem $fs is mounted or listed in fstab; refusing this blacklist."
            return 1
        fi
    done
    if [[ ! -e "$conf_file_fs" || "$CONFIG_POLICY" == replace ]]; then
        write_config "$conf_file_fs" <<'EOF'
install cramfs /bin/false
install freevxfs /bin/false
install jffs2 /bin/false
install hfs /bin/false
install hfsplus /bin/false
# Common local, optical, virtual and network filesystems are deliberately kept.
EOF
    fi
}

