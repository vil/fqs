install_virtmanager() {
    echo -e "\n=> Installing virt-manager..."
    sudo dnf install virt-manager libvirt qemu-kvm -y
    if getent group libvirt >/dev/null; then sudo usermod -aG libvirt "$(id -un)"; fi
    if unit_exists virtqemud.socket; then
        sudo systemctl enable --now virtqemud.socket virtnetworkd.socket
    else
        sudo systemctl enable --now libvirtd.service
    fi
}

add_dev_tools() {
    echo -e "\n=> Installing Developer Tools..."
    sudo dnf install kernel-devel android-tools python3-pip python3-devel git nodejs nodejs-npm golang -y
}

install_nvidia() {
    echo -e "\n=> Installing Nvidia Drivers..."
    local sb_state
    if [[ -d /sys/firmware/efi ]]; then
        if ! command_exists mokutil || ! sb_state=$(mokutil --sb-state) ||
           ! grep -qi 'SecureBoot disabled' <<< "$sb_state"; then
            fail 'Secure Boot is enabled or cannot be checked. Configure akmods signing and MOK manually first.'
            return 1
        fi
    fi
    if ! lspci -nn | grep -Ei '(VGA|3D|Display)' | grep -qi nvidia; then
        fail 'No NVIDIA display controller detected.'; return 1
    fi
    sudo dnf install akmod-nvidia -y
}

hid_apple_patch() {
    echo -e "\n=> Patching Apple Keyboard (hid_apple)..."
    local conf_file="/etc/modprobe.d/hid_apple.conf"
    write_config "$conf_file" <<'EOF'
options hid_apple fnmode=0
EOF
    printf 'Keyboard option will apply at reboot; the active keyboard is not unloaded.\n'
}

add_dracut_flags() {
    echo -e "\n=> Adding Dracut Flags (Bluetooth Decryption)..."
    local conf_file="/etc/dracut.conf.d/flags.conf"
    dracut --list-modules | grep -qx '[[:space:]]*bluetooth' || {
        fail 'This dracut installation has no bluetooth module.'; return 1;
    }
    write_config "$conf_file" <<'EOF'
add_dracutmodules+=" bluetooth "
EOF
    printf 'Configuration saved for future initramfs builds; no existing recovery images were overwritten.\n'
}

install_tor() {
    echo -e "\n=> Installing Tor..."
    sudo dnf install tor torbrowser-launcher -y
    sudo systemctl enable --now tor
}

install_selection() {
    echo -e "\n=> Installing extra packages: $1"
    local pkg
    local -a packages
    read -r -a packages <<< "$1"
    for pkg in "${packages[@]}"; do
        if [[ "$pkg" == flatpak:* ]]; then
            ensure_flatpak
            sudo flatpak install --system -y flathub "${pkg#flatpak:}"
        else
            if rpm -q -- "$pkg" &>/dev/null; then continue; fi
            sudo dnf install -y -- "$pkg"
        fi
    done
}

setup_bash_prompt() {
    echo -e "\n=> Setting up Bash Prompt..."
    if [[ -L "$HOME/.bashrc" ]]; then printf 'Keeping symlinked .bashrc; prompt skipped.\n'; return 0; fi
    if ! grep -q "PS1_CMD1" "$HOME/.bashrc" 2>/dev/null; then
        if [[ -e "$HOME/.bashrc" ]]; then
            if [[ "$CONFIG_POLICY" == keep ]]; then printf 'Keeping existing .bashrc; prompt skipped.\n'; return 0; fi
            cp -p -- "$HOME/.bashrc" "$HOME/.bashrc.fqs-$(date +%Y%m%d-%H%M%S)-$$.bak"
        fi
        tee -a "$HOME/.bashrc" >/dev/null <<'EOF'
# Vili's Bash prompt
PROMPT_COMMAND='PS1_CMD1=$(git branch --show-current 2>/dev/null)'
PS1='\[\e[2m\]\t\[\e[0m\] \w ${PS1_CMD1} \$ '
EOF
    fi
}

setup_config() {
    echo -e "\n=> Setting up SSH and Git..."
    if ! command_exists git; then sudo dnf install git -y; fi
    if ! command_exists ssh-keygen; then sudo dnf install -y openssh-clients; fi
    if [[ -L "$HOME/.ssh" || -L "$HOME/.ssh/id_ed25519" || -L "$HOME/.ssh/id_ed25519.pub" ]]; then
        fail 'Refusing to generate SSH keys through a symlink.'; return 1
    fi
    mkdir -p "$HOME/.ssh"
    chmod 0700 "$HOME/.ssh"
    if [[ ! -e "$HOME/.ssh/id_ed25519" && ! -e "$HOME/.ssh/id_ed25519.pub" ]]; then
        # Interactive passphrase entry is deliberate; never silently create an unencrypted key.
        ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519"
    else
        printf 'Keeping existing SSH key files.\n'
    fi
    local key value
    for key in user.name user.email; do
        if [[ "$key" == user.name ]]; then value="$1"; else value="$2"; fi
        if git config --global --get "$key" >/dev/null; then
            printf 'Keeping existing Git %s.\n' "$key"
        else
            git config --global "$key" "$value"
        fi
    done
}

