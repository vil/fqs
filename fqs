    register_option DIS_WIFI 'Disable Wi-Fi' Disruptive off disable_wifi 'Turns off Wi-Fi in NetworkManager, blocks its radio and stops wpa_supplicant. Also blocks several common Wi-Fi modules for future boots, but not every possible driver. Wireless connectivity is lost immediately. Only run with another working connection and local console. Remove the rule and unblock/re-enable Wi-Fi to restore.'
}

selected() { [[ "${SELECTED[$1]:-off}" == on ]]; }

ui_message() { whiptail --title "$1" --scrolltext --msgbox "$2" "$UI_HEIGHT" "$UI_WIDTH"; }

configure_group() {
    local group="$1" id choice status state other
    local -a items
    while true; do
        items=()
        for id in "${OPTION_IDS[@]}"; do
            [[ "${GROUP[$id]}" == "$group" ]] || continue
            state='[ ]'; if selected "$id"; then state='[x]'; fi
            items+=("$id" "$state ${LABEL[$id]}")
        done
        if choice=$(whiptail --title "$group options" --cancel-button Back --menu \
            'Choose an item to read what it changes, its risks and how to undo it. Nothing is applied yet. Arrow keys: move | Enter: details | Esc: back' \
            "$UI_HEIGHT" "$UI_WIDTH" "$LIST_HEIGHT" "${items[@]}" 3>&1 1>&2 2>&3); then
            state=Enable; if selected "$choice"; then state=Disable; fi
            if whiptail --title "${LABEL[$choice]}" --scrolltext --defaultno \
                --yes-button "$state" --no-button Back --yesno \
                "${DETAIL[$choice]}\n\nCurrent selection: ${SELECTED[$choice]}. Choose $state to change the plan; Back leaves it unchanged." \
                "$UI_HEIGHT" "$UI_WIDTH"; then
                if selected "$choice"; then
                    SELECTED[$choice]=off
                else
                    case "$group" in
                        Browser|Editor|VPN)
                            for other in "${OPTION_IDS[@]}"; do
                                if [[ "${GROUP[$other]}" == "$group" ]]; then SELECTED[$other]=off; fi
                            done ;;
                    esac
                    SELECTED[$choice]=on
                fi
            else
                status=$?
                if [[ "$status" != 1 && "$status" != 255 ]]; then return "$status"; fi
            fi
        else
            status=$?
            if [[ "$status" == 1 || "$status" == 255 ]]; then return 0; fi
            return "$status"
        fi
    done
}

validate_dns() {
    python3 - "$1" <<'PY'
import ipaddress
import re
import sys
if '\n' in sys.argv[1] or '\r' in sys.argv[1]:
    sys.exit('DNS addresses must be on a single line.')
entries = sys.argv[1].split()
if not entries:
    sys.exit('Enter at least one DNS IP address.')
for entry in entries:
    ip, separator, hostname = entry.partition('#')
    try:
        ipaddress.ip_address(ip)
    except ValueError:
        sys.exit(f'Invalid DNS IP: {ip}')
    if '%' in ip or (separator and not re.fullmatch(r'(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?', hostname)):
        sys.exit('Invalid DNS TLS hostname or address scope.')
PY
}

valid_packages() {
    local text="$1" pkg
    local -a packages
    [[ "$text" != *$'\n'* && "$text" != *$'\r'* ]] || return 1
    read -r -a packages <<< "$text"
    for pkg in "${packages[@]}"; do
        if [[ "$pkg" == flatpak:* ]]; then
            [[ "${pkg#flatpak:}" =~ ^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+){2,}$ ]] || return 1
        else
            [[ "$pkg" =~ ^[A-Za-z0-9][A-Za-z0-9+_.:-]*$ ]] || return 1
        fi
    done
}

