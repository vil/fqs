            else
                mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}"
                git clone https://github.com/NvChad/starter "${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
            fi ;;
    esac
}

setup_protonge() {
    echo -e "\n=> Installing Steam and Proton-GE..."
    sudo dnf install steam -y
    python3 - "$WORK_DIR" "$HOME/.steam/root/compatibilitytools.d" <<'PY'
import hashlib
import json
import pathlib
import platform
import re
import shutil
import sys
import tarfile
import urllib.request
work, destination = map(pathlib.Path, sys.argv[1:])
def download(url):
    if not url.startswith('https://'):
        raise ValueError('Refusing a non-HTTPS download')
    return urllib.request.urlopen(url, timeout=60)
with download('https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest') as response:
    release = json.load(response)
assets = {item['name']: item['browser_download_url'] for item in release['assets']}
tag = release['tag_name']
if not re.fullmatch(r'GE-Proton[\w.-]+', tag):
    raise ValueError('Unexpected Proton-GE release tag')
architecture = platform.machine()
if architecture not in ('x86_64', 'aarch64'):
    raise ValueError(f'Unsupported Proton-GE architecture: {architecture}')
name = f'{tag}-{architecture}.tar.gz'
if name not in assets and architecture == 'x86_64':
    name = f'{tag}.tar.gz'  # Older x86_64 releases used unsuffixed assets.
if name not in assets:
    raise ValueError(f'Release has no archive for {architecture}')
root = tag
target = destination / root
if target.exists() or target.is_symlink():
    print(f'Keeping existing Proton-GE installation: {target}')
    sys.exit(0)
checksum = name.removesuffix('.tar.gz') + '.sha512sum'
if checksum not in assets:
    raise ValueError('Release has no SHA-512 checksum; refusing unverified extraction')
with download(assets[checksum]) as response:
    expected = response.read(16384).decode().split()[0]
if not re.fullmatch(r'[a-fA-F0-9]{128}', expected):
    raise ValueError('Invalid release checksum')
archive = work / name
hasher = hashlib.sha512()
with download(assets[name]) as response, archive.open('wb') as output:
    while chunk := response.read(1024 * 1024):
        hasher.update(chunk)
        output.write(chunk)
if hasher.hexdigest().lower() != expected.lower():
    raise ValueError('Proton-GE checksum mismatch')
staging = work / 'proton'
staging.mkdir()
with tarfile.open(archive) as package:
    members = package.getmembers()
    roots = set()
    for member in members:
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or '..' in path.parts or not path.parts:
            raise ValueError('Unexpected archive path')
        roots.add(path.parts[0])
    if len(roots) != 1 or not roots.issubset({tag, f'{tag}-{architecture}'}):
        raise ValueError('Unexpected archive root directory')
    root = roots.pop()
    target = destination / root
    if target.exists() or target.is_symlink():
        print(f'Keeping existing Proton-GE installation: {target}')
        sys.exit(0)
    package.extractall(staging, filter='data')
if not (staging / root).is_dir():
    raise ValueError('Proton-GE archive does not contain an installation directory')
destination.mkdir(parents=True, exist_ok=True)
shutil.move(str(staging / root), str(target))
print(f'Installed {root}. Restart Steam to select it for individual games.')
PY
}

