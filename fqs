choose_dnssec() {
    whiptail --title 'DNSSEC validation: security vs compatibility' --scrolltext --msgbox \
        'DNSSEC validates signed DNS data; DNS-over-TLS encrypts the connection to your resolver. They provide different protections.\n\nyes (default): enforce validation. Invalid signatures are rejected, and DNS lookups can fail if the resolver/network cannot support DNSSEC. Unsigned domains can still resolve; this does not require every domain to be signed.\n\nallow-downgrade: validate when support is detected, but allow validation to be disabled if the resolver appears not to support it. More compatible, but an attacker may be able to trigger this downgrade and remove DNSSEC protection.\n\nDNS-over-TLS remains strict (yes) with either choice. Choose the tradeoff explicitly; Cancel returns without applying changes.' \
        "${1:-24}" "${2:-80}" || return $?
    whiptail --title 'DNSSEC validation: security vs compatibility' --default-item yes --menu \
        'Choose DNSSEC validation mode. DNS-over-TLS remains strict in both modes.' \
        "${1:-24}" "${2:-80}" 2 \
        yes 'Strict validation; fail if DNSSEC support is unavailable' \
        allow-downgrade 'Compatibility fallback; susceptible to downgrade attacks' \
        3>&1 1>&2 2>&3
}

enable_secure_dns() {
    local dns_ips="$1" dnssec_mode="${2:-yes}"
    case "$dnssec_mode" in
        yes|allow-downgrade) ;;
        *) fail "Unsupported DNSSEC mode: $dnssec_mode"; return 1 ;;
    esac
    echo -e "\n=> Enabling DNS-over-TLS with DNSSEC=$dnssec_mode and servers: $dns_ips"
    validate_dns "$dns_ips"
    unit_exists systemd-resolved.service || { fail 'systemd-resolved is not installed.'; return 1; }
    write_config /etc/systemd/resolved.conf.d/dns_over_tls.conf <<EOF
[Resolve]
DNS=$dns_ips
FallbackDNS=
Domains=~.
DNSOverTLS=yes
DNSSEC=$dnssec_mode
DNSStubListener=yes
EOF
}

restart_networking_stack() {
    echo -e "\n=> Restarting networking stack..."
    # Do not disconnect interfaces or force NetworkManager restarts.
    sudo systemctl enable --now systemd-resolved.service
    sudo systemctl restart systemd-resolved.service
    printf 'DNS configuration written. Verify with resolvectl status/query; VPN or per-link DNS may still take precedence.\n'
}

strict_flatpak_overrides() {
    echo -e "\n=> Applying Strict Flatpak Overrides & Installing Flatseal..."
    ensure_flatpak
    # Preserve the existing global override file before the Flatpak CLI edits it.
    if sudo test -e /var/lib/flatpak/overrides/global; then
        if [[ "$CONFIG_POLICY" == keep ]]; then
            printf 'Keeping existing global Flatpak overrides; restrictions skipped.\n'
            return 0
        fi
        if [[ -z "$BACKUP_DIR" ]]; then
            BACKUP_DIR="/var/backups/fqs/$(date +%Y%m%d-%H%M%S)-$$"
            sudo install -d -m 0700 "$BACKUP_DIR"
        fi
        sudo cp --parents --preserve=all /var/lib/flatpak/overrides/global "$BACKUP_DIR/"
    fi
    sudo flatpak install --system -y flathub com.github.tchx84.Flatseal
    sudo flatpak override --system --nofilesystem=host --nofilesystem=home --nodevice=all
}

hardened_kernel_args() {
    echo -e "\n=> Applying hardened kernel arguments..."
    local kargs=(
            # Page Table Isolation — mitigates Meltdown (CVE-2017-5754)
            "pti=on"

            # Spectre v2 mitigation
            "spectre_v2=on"

            # Speculative Store Bypass Disable
            "spec_store_bypass_disable=on"
            "ssbd=force-on"

            # IOMMU — protects against DMA attacks from PCIe devices
            # Covers both Intel VT-d and AMD-Vi
            "intel_iommu=on"
            "amd_iommu=on"
            "iommu=force"
            "iommu.passthrough=0"
            "iommu.strict=1"

            # Initialize memory on allocation and free — mitigates use-after-free
            # and uninitialized read vulnerabilities
            "init_on_alloc=1"
            "init_on_free=1"

            # Randomize kernel stack offset on syscall entry
            "randomize_kstack_offset=on"

            # Shuffle free memory page allocator lists — hardens ASLR
            "page_alloc.shuffle=1"

            # Do not trust bootloader or CPU for initial entropy seeding
            "random.trust_bootloader=off"
            "random.trust_cpu=off"

            # Restrict /proc/pid/mem access to ptrace-capable processes
            "proc_mem.force_override=ptrace"


            # Disable systemd emergency SSH auto-spawn (systemd >= 255)
            "systemd.ssh_auto=no"
    )
    command_exists grubby || { fail 'grubby is required for kernel arguments.'; return 1; }
    local kernel
    kernel=$(sudo grubby --default-kernel)
    [[ -f "$kernel" ]] || { fail 'Cannot identify the default kernel.'; return 1; }
    [[ $(find /boot -maxdepth 1 -name 'vmlinuz-*' -type f | wc -l) -ge 2 ]] || {
        fail 'Keep at least two installed kernels before changing boot arguments.'; return 1;
    }
    if [[ -z "$BACKUP_DIR" ]]; then
        BACKUP_DIR="/var/backups/fqs/$(date +%Y%m%d-%H%M%S)-$$"
        sudo install -d -m 0700 "$BACKUP_DIR"
    fi
    sudo cp --parents --preserve=all -r /boot/loader/entries "$BACKUP_DIR/"
    sudo grubby --update-kernel="$kernel" --args="${kargs[*]}"
    printf 'Changed the default kernel only. Keep an older kernel as a recovery option.\n'
}

setup_usbguard() {
    echo -e "\n=> Setting up USBGuard..."
    sudo dnf install -y usbguard usbguard-notifier
    local policy
    policy=$(mktemp "$WORK_DIR/usbguard.XXXXXX")
    sudo usbguard generate-policy > "$policy"
    [[ -s "$policy" ]] || { fail 'USBGuard generated an empty policy; refusing to enable enforcement.'; return 1; }
    write_config /etc/usbguard/rules.conf 0600 < "$policy"
    if [[ "$CONFIG_READY" != true ]]; then
        printf 'Existing USBGuard policy kept; service activation skipped for safety.\n'
        return 0
    fi
    sudo systemctl enable usbguard.service
    if [[ "$CONFIG_CHANGED" == true ]]; then
        sudo systemctl restart usbguard.service
    else
        sudo systemctl start usbguard.service
    fi
    printf 'USBGuard enabled for currently attached devices. Use sudo usbguard list-devices to inspect blocks.\n'
}

setup_firewall_drop() {
    echo -e "\n=> Configuring Firewalld (Setting default zone to DROP)..."
    sudo dnf install -y firewalld
    sudo systemctl enable --now firewalld.service
    # Only change the default; never persist unrelated runtime rules.
    sudo firewall-cmd --set-default-zone=drop
    printf 'Explicit per-connection zones are unchanged. Verify with firewall-cmd --get-active-zones.\n'
}

