    echo -e "\n=> Installing and enabling Fail2Ban..."
    sudo dnf install -y fail2ban
    sudo systemctl enable --now fail2ban
}

mac_randomization() {
    echo -e "\n=> Enabling MAC Randomization..."
    local macrandomize_rule="/etc/NetworkManager/conf.d/00-macrandomize.conf"
    if [[ ! -e "$macrandomize_rule" || "$CONFIG_POLICY" == replace ]]; then
        write_config "$macrandomize_rule" <<'EOF'
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
EOF
    fi
}

prevent_sending_dhcp_hostname() {
    echo -e "\n=> Preventing sending DHCP hostname..."
    local dhcp_hostname_rule="/etc/NetworkManager/conf.d/10-dhcp-hostname.conf"
    if [[ ! -e "$dhcp_hostname_rule" || "$CONFIG_POLICY" == replace ]]; then
        write_config "$dhcp_hostname_rule" <<'EOF'
[connection]
# Prevent sending machine hostname to DHCP server.
# Hostname leakage allows network operators to identify and track devices.
ipv4.dhcp-send-hostname=false
ipv6.dhcp-send-hostname=false
EOF
    fi
}

ipv6_privacy() {
    echo -e "\n=> Enabling IPv6 Privacy Extensions..."
    local ipv6_privacy_rule="/etc/NetworkManager/conf.d/00-ipv6-privacy.conf"
    if [[ ! -e "$ipv6_privacy_rule" || "$CONFIG_POLICY" == replace ]]; then
        write_config "$ipv6_privacy_rule" <<'EOF'
