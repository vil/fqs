configure_git_action() { setup_config "$GIT_NAME" "$GIT_EMAIL"; }
configure_dns_action() {
    enable_secure_dns "$DNS_IPS" "$DNSSEC_MODE"
    if [[ "$CONFIG_READY" == true ]]; then
        restart_networking_stack
    else
        printf 'Conflicting DNS configuration kept; resolver restart skipped.\n'
    fi
}

report_config_skips() {
    local target=''
    if [[ "$CONFIG_POLICY" != keep ]]; then return 0; fi
    # These legacy helpers bypass write_config entirely when the file exists.
    case "$1" in
        MAC_RAND) target=/etc/NetworkManager/conf.d/00-macrandomize.conf ;;
        HOSTNAME_SENDING) target=/etc/NetworkManager/conf.d/10-dhcp-hostname.conf ;;
        IPV6_PRIV) target=/etc/NetworkManager/conf.d/00-ipv6-privacy.conf ;;
        DIS_FS) target=/etc/modprobe.d/disable-fs.conf ;;
        DIS_OBSOLETE_NETWORKING) target=/etc/modprobe.d/disable-obsolete-networking.conf ;;
        DIS_THUNDERBOLT) target=/etc/modprobe.d/disable-fireware-thunderbolt.conf ;;
    esac
    if [[ -n "$target" && ( -e "$target" || -L "$target" ) ]]; then
        printf 'Keeping existing configuration; new settings skipped: %s\n' "$target"
    fi
}

execute_plan() {
    local id phase
    # Keep disruptive changes after every download, including extra packages.
    for phase in normal disruptive; do
        for id in "${OPTION_IDS[@]}"; do
            if ! selected "$id"; then continue; fi
            if [[ "$phase" == normal && "${GROUP[$id]}" == Disruptive ]]; then continue; fi
            if [[ "$phase" == disruptive && "${GROUP[$id]}" != Disruptive ]]; then continue; fi
            CURRENT_ACTION="${LABEL[$id]}"
            printf '\n=> %s\n' "$CURRENT_ACTION"
            report_config_skips "$id"
            # Never put actions (or this function/main) in an if/&&/|| condition:
            # Bash would suppress errexit inside the called action helpers.
            "${ACTION[$id]}" "$id"
        done
        if [[ "$phase" == normal && -n "$EXTRA_PKGS" ]]; then
            CURRENT_ACTION='Extra packages'
            install_selection "$EXTRA_PKGS"
        fi
    done
}

startup_checks() {
    local cmd rows columns options path lock_dir
    [[ "$EUID" -ne 0 ]] || { fail 'Run FQS as your normal user, not root or sudo.'; return 1; }
    [[ -t 0 && -t 1 && -t 2 ]] || { fail 'An interactive terminal is required on stdin, stdout and stderr.'; return 1; }
    [[ -n "${TERM:-}" && "$TERM" != dumb ]] || { fail 'A capable TERM setting is required.'; return 1; }
    [[ -r /etc/os-release ]] || { fail 'Cannot identify this operating system.'; return 1; }
    local ID=''
    # shellcheck source=/dev/null
    . /etc/os-release
    [[ "$ID" == fedora ]] || { fail 'FQS supports Fedora only.'; return 1; }
    [[ ! -e /run/ostree-booted ]] || { fail 'Immutable/OSTree Fedora is not supported; use a writable DNF system.'; return 1; }
    for cmd in dnf rpm systemctl sudo python3 curl mktemp stty readlink findmnt flock; do
        command_exists "$cmd" || { fail "Required command is unavailable: $cmd"; return 1; }
    done
    [[ -d /run/systemd/system ]] && systemctl show --property=Version --value >/dev/null || {
        fail 'A running systemd system manager is required.'; return 1;
    }
    for path in /usr /etc /var; do
        options=$(findmnt -n -o OPTIONS --target "$path") || return 1
        case ",$options," in *,ro,*) fail "$path is read-only; a writable Fedora DNF installation is required."; return 1 ;; esac
    done
    read -r rows columns < <(stty size)
    [[ "$rows" =~ ^[0-9]+$ && "$columns" =~ ^[0-9]+$ ]] || {
        fail 'Cannot determine terminal size.'; return 1;
    }
    if (( rows < 24 || columns < 80 )); then fail 'Resize the terminal to at least 80 columns by 24 rows.'; return 1; fi
    UI_HEIGHT=$((rows - 2)) UI_WIDTH=$((columns - 2))
    if (( UI_HEIGHT > 32 )); then UI_HEIGHT=32; fi
    if (( UI_WIDTH > 110 )); then UI_WIDTH=110; fi
    LIST_HEIGHT=$((UI_HEIGHT - 10))
    lock_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/fqs"
    mkdir -p -m 0700 "$lock_dir"
    # Lock the directory without creating/truncating a potentially linked file.
    exec 9< "$lock_dir"
    flock --nonblock 9 || { fail 'Another FQS session is already running.'; return 1; }
}

ensure_whiptail() {
    local approval
    if command_exists whiptail; then return 0; fi
    printf 'FQS needs whiptail for its menus. Installing it is a system change BEFORE plan review.\n'
    printf 'No other actions or sudo keeper will start now. Type INSTALL to approve sudo dnf install -y newt, or anything else to cancel: '
    read -r approval || return 1
    if [[ "$approval" != INSTALL ]]; then printf 'Cancelled; whiptail was not installed.\n'; return 1; fi
    sudo dnf install -y newt
    command_exists whiptail
}

main() {
    set -Eeuo pipefail
    trap cleanup EXIT
    trap 'on_error "$?" "$LINENO"' ERR
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    startup_checks
    WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fqs.XXXXXXXX")
    ensure_whiptail
    init_options
    EXTRA_PKGS=''
    local choice error plan
    while true; do
        choice=$(whiptail --title 'FQS - build your plan' --cancel-button Quit --menu \
            'Only package updates are selected initially. Enter a category, then read/toggle individual actions. Nothing is applied until review and explicit confirmation. Configuration backups are not full rollback.' \
            "$UI_HEIGHT" "$UI_WIDTH" "$LIST_HEIGHT" \
            System 'Updates, download settings and repositories' \
            Network 'Network privacy and encrypted DNS' \
            Security 'Services, permissions and advanced hardening' \
            Hardware 'Drivers and hardware configuration' \
            Apps 'Applications, development tools and Git' \
            Browser 'Choose at most one; Firefox is retained' \
            Editor 'Choose at most one editor' \
            VPN 'Choose at most one VPN client' \
            Disruptive 'Local-console-only device/network changes' \
            Policy "Existing configuration: $CONFIG_POLICY" \
            Extras 'Optional validated RPM/Flatpak packages' \
            Review 'Collect details, check and review selected actions' \
            3>&1 1>&2 2>&3) || { printf 'Cancelled; no selected actions were run.\n'; return 0; }
        case "$choice" in
            Policy) configure_policy || continue ;;
            Extras) configure_extra_packages || continue ;;
            Review)
                collect_inputs || continue
                if error=$(preflight_checks 2>&1); then
                    plan=$(build_review)
                    if whiptail --title 'Review - no automatic rollback' --scrolltext --defaultno \
                        --yes-button Apply --no-button Back --yesno "$plan" "$UI_HEIGHT" "$UI_WIDTH"; then
                        break
                    fi
                else
                    ui_message 'Preflight failed - nothing applied' "$error" || continue
                fi ;;
            *) configure_group "$choice" ;;
        esac
    done
    CURRENT_ACTION='Sudo authentication'
    sudo -v
    # Start credential refresh only after explicit approval of the complete plan.
    ( exec 9<&-; trap - EXIT ERR INT TERM HUP; while sleep 50; do sudo -n -v || exit; done ) &
    SUDO_PID=$!
    printf '\nApplying the reviewed plan. Earlier changes are NOT rolled back on failure.\n'
    execute_plan
    CURRENT_ACTION='complete'
    printf '\nSelected actions finished. Check kept/skipped settings and warnings above; this is not a guarantee of system security.\n'
    if [[ -n "$BACKUP_DIR" ]]; then printf 'Configuration backups: %s\n' "$BACKUP_DIR"; fi
    printf 'No automatic reboot was performed. Review whether your updates, drivers or boot changes require one.\n'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
