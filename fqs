                while true; do
                    DNS_IPS=$(whiptail --title 'Custom DNS-over-TLS' --inputbox \
                        'Space-separated IPs, optionally with #TLS-hostname. Without a hostname, the server certificate must authenticate the IP. No URLs, ports or configuration directives.' \
                        12 "$UI_WIDTH" "$DNS_IPS" 3>&1 1>&2 2>&3) || return 1
                    if error=$(validate_dns "$DNS_IPS" 2>&1); then break; fi
                    ui_message 'Invalid DNS addresses' "$error" || return 1
                done ;;
        esac
        DNS_PROVIDER="$choice"
        DNSSEC_MODE=$(choose_dnssec "$UI_HEIGHT" "$UI_WIDTH") || return 1
    fi
    GIT_NAME='' GIT_EMAIL=''
    if selected GIT_SSH; then
        if command_exists git; then
            GIT_NAME=$(git config --global --get user.name || true)
            GIT_EMAIL=$(git config --global --get user.email || true)
        fi
        while [[ ! "$GIT_NAME" =~ [^[:space:]] ]]; do
            GIT_NAME=$(whiptail --title 'Git commit identity' --inputbox \
                'Name for Git commits (required). Existing global Git values are never replaced. SSH key generation will ask for a passphrase during execution.' \
                12 "$UI_WIDTH" 3>&1 1>&2 2>&3) || return 1
        done
        if [[ -z "$GIT_EMAIL" ]]; then
            while [[ ! "$GIT_EMAIL" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]]; do
                GIT_EMAIL=$(whiptail --title 'Git commit email' --inputbox \
                    'Email for Git commits, e.g. you@example.org or your forge no-reply address. Existing global values are retained.' \
                    12 "$UI_WIDTH" 3>&1 1>&2 2>&3) || return 1
            done
        fi
    fi
    return 0
}

configure_policy() {
    local choice
    choice=$(whiptail --title 'Existing configuration files' --default-item "$CONFIG_POLICY" \
        --cancel-button Back --menu \
        'Keep is the default. Replacement backs up changed files, not packages, service state or every change. Neither choice provides automatic rollback. Symlink safety checks and always-preserved user settings still apply.' \
        "$UI_HEIGHT" "$UI_WIDTH" 2 \
        keep 'Keep existing files; conflicting new settings are skipped' \
        replace 'Back up existing files, then replace with selected settings' \
        3>&1 1>&2 2>&3) || return 1
    CONFIG_POLICY="$choice"
}

configure_extra_packages() {
    local text
    while true; do
        text=$(whiptail --title 'Extra packages' --cancel-button Back --inputbox \
            'Optional space-separated RPM package names or flatpak:APP.ID entries (example: htop flatpak:org.videolan.VLC). No options, URLs, paths, wildcards or shell commands. Flatpaks use system-wide Flathub, which will be added if needed. Blank skips extras.' \
            "$UI_HEIGHT" "$UI_WIDTH" "$EXTRA_PKGS" 3>&1 1>&2 2>&3) || return 1
        if valid_packages "$text"; then EXTRA_PKGS="$text"; return 0; fi
        ui_message 'Invalid package list' 'Use only package names or flatpak:APP.ID entries separated by spaces. Options, URLs, paths and shell syntax are not accepted.' || return 1
    done
}

build_review() {
    local id
    printf 'FQS execution plan\n\n'
    printf 'Configuration policy: %s\n' "$CONFIG_POLICY"
    if [[ "$CONFIG_POLICY" == keep ]]; then
        printf 'Existing files are kept; selected settings may be SKIPPED. Packages and service changes can still run. Watch stdout for kept/skipped configuration messages.\n'
    else
        printf 'Changed configuration files are backed up under /var/backups/fqs; .bashrc backups stay beside the original. Backups are NOT a full-system rollback.\n'
    fi
    printf '\nOnly the following selected actions will run:\n'
    for id in "${OPTION_IDS[@]}"; do
        if selected "$id"; then
            printf '\n[%s] %s\n%s\n' "${GROUP[$id]}" "${LABEL[$id]}" "${DETAIL[$id]}"
        fi
    done
    if selected SECURE_DNS; then
        printf '\nDNS provider: %s\nDNS servers: %s\nDNSSEC mode: %s\n' "$DNS_PROVIDER" "$DNS_IPS" "$DNSSEC_MODE"
    fi
    if selected GIT_SSH; then
        printf '\nGit name: %s\nGit email: %s\nExisting Git identity and SSH keys are retained.\n' "$GIT_NAME" "$GIT_EMAIL"
    fi
    printf '\nExtra packages: %s\n' "${EXTRA_PKGS:-none}"
    printf '\nPackage/repository, service, network, permission and boot changes are NOT automatically rolled back, even on failure or cancellation. Configuration backups do not undo all changes.\n'
    printf 'Progress and configuration skips are printed to stdout; no persistent log is created. No automatic reboot, Secure Boot enrollment or Firefox removal.\n\nApply this plan? Back returns to the menu without applying it.\n'
}

preflight_checks() {
    local id repos target sb_state
    for id in "${OPTION_IDS[@]}"; do
        if selected "$id" && [[ "${GROUP[$id]}" == Disruptive ]] &&
            [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
            fail "${LABEL[$id]} is unavailable over SSH. Use a local console or deselect it."
            return 1
        fi
    done
    if selected DIS_BT && selected DRACUT; then
        fail 'Disabling Bluetooth conflicts with Bluetooth keyboard initramfs support.'
        return 1
    fi
    if ! valid_packages "$EXTRA_PKGS"; then fail 'Invalid extra packages.'; return 1; fi
    if ! selected REPOS; then
        if selected STEAM || selected NVIDIA || selected ZED; then
            repos=$(dnf -q --cacheonly repolist --enabled) || {
                fail 'Cannot inspect enabled repositories from the DNF cache. Select repository setup or configure/cache repositories manually.'
                return 1
            }
            if selected STEAM || selected NVIDIA; then
                if ! grep -Eq '^rpmfusion-nonfree([[:space:]]|-updates[[:space:]])' <<< "$repos"; then
                    fail 'Steam/NVIDIA requires enabled RPM Fusion Nonfree; select repository setup or enable it manually.'
                    return 1
                fi
            fi
            if selected ZED && ! grep -Eq '^terra[[:space:]]' <<< "$repos"; then
                fail 'Zed requires enabled Terra; select repository setup or enable it manually.'
                return 1
            fi
        fi
    fi
    if selected SECURE_DNS; then
        validate_dns "$DNS_IPS" || return 1
        case "$DNSSEC_MODE" in yes|allow-downgrade) ;; *) fail 'Invalid DNSSEC mode.'; return 1 ;; esac
        if ! unit_exists systemd-resolved.service; then
            fail 'Install systemd-resolved and integrate /etc/resolv.conf before selecting secure DNS.'
            return 1
        fi
        target=$(readlink -m /etc/resolv.conf) || return 1
        if [[ ! -L /etc/resolv.conf || "$target" != /run/systemd/resolve/stub-resolv.conf ]]; then
            fail 'Secure DNS requires /etc/resolv.conf to link to /run/systemd/resolve/stub-resolv.conf. Configure resolved integration manually first; FQS will not replace resolv.conf.'
            return 1
        fi
    fi
    if selected DRACUT; then
        if ! command_exists dracut || ! dracut --list-modules | grep -qx '[[:space:]]*bluetooth'; then
            fail 'Bluetooth initramfs support requires an installed dracut Bluetooth module.'
            return 1
        fi
    fi
    if selected NVIDIA; then
        if ! command_exists lspci || ! lspci -nn | grep -Ei '(VGA|3D|Display)' | grep -qi nvidia; then
            fail 'NVIDIA installation requires a detected NVIDIA display controller (lspci).'
            return 1
        fi
        if [[ -d /sys/firmware/efi ]]; then
            if ! command_exists mokutil || ! sb_state=$(mokutil --sb-state) ||
                ! grep -qi 'SecureBoot disabled' <<< "$sb_state"; then
                fail 'Secure Boot is enabled or cannot be checked. Prepare akmods signing/MOK manually; FQS never enrolls keys.'
                return 1
            fi
        fi
    fi
    return 0
}

browser_action() {
    case "$1" in
        HELIUM) install_browser Helium ;;
        TRIVALENT) install_browser Trivalent ;;
        BRAVE) install_browser Brave ;;
        CHROMIUM) install_browser Chromium ;;
        LIBREWOLF) install_browser Librewolf ;;
        *) fail "Unknown browser option: $1" ;;
    esac
}

editor_action() {
    case "$1" in
        ZED) install_code_editor Zed ;;
        VSCODIUM) install_code_editor VSCodium ;;
        NEOVIM) install_code_editor NeoVim ;;
        *) fail "Unknown editor option: $1" ;;
    esac
}

vpn_action() {
    case "$1" in
        IVPN) install_vpn_app IVPN ;;
        MULLVAD) install_vpn_app Mullvad ;;
